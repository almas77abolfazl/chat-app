{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker: start mongo",
      "type": "shell",
      "command": "docker compose up -d mongo",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "docker: full stack (all)",
      "type": "shell",
      "command": "docker compose up -d",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "docker: stop all",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "frontend: ng serve (watch)",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "chat-app-front"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*(Building|Generating|Compiling).*$",
          "endsPattern": "^.*(Watch mode enabled|Application bundle generation complete|Local:\\s+http).*$"
        }
      }
    }
  ]
}