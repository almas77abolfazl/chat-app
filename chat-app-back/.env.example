# Server
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/chat-app
BASE_URL=http://localhost

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=60m

# LLM / Agentic assistant (optional)
# Free option: get a key at https://aistudio.google.com/apikey (Google AI Studio)
# The endpoint below is OpenAI-compatible, so OpenRouter/Groq/Ollama also work:
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   Ollama:     http://localhost:11434/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
AGENT_ENABLED=true
AGENT_MAX_ITERATIONS=6
AGENT_BOT_PHONE_NUMBER=09000000000
